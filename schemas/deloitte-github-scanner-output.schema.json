{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/postman-cs/deloitte-postman-workspace-access-action/schemas/deloitte-github-scanner-output.schema.json",
  "title": "Deloitte GitHub scanner workspace members",
  "oneOf": [
    {
      "type": "array",
      "items": { "$ref": "#/$defs/member" }
    },
    {
      "type": "object",
      "properties": {
        "schemaVersion": { "type": ["integer", "string"] },
        "repository": { "type": "string" },
        "members": {
          "type": "array",
          "items": { "$ref": "#/$defs/member" }
        },
        "collaborators": {
          "type": "array",
          "items": { "$ref": "#/$defs/member" }
        }
      },
      "anyOf": [
        { "required": ["members"] },
        { "required": ["collaborators"] }
      ],
      "additionalProperties": true
    }
  ],
  "$defs": {
    "member": {
      "type": "object",
      "anyOf": [
        { "required": ["email"] },
        { "required": ["login"] }
      ],
      "properties": {
        "email": { "type": "string", "format": "email" },
        "login": { "type": "string" },
        "type": { "type": "string" },
        "externalId": { "type": ["string", "number"] },
        "external_id": { "type": ["string", "number"] },
        "scimId": { "type": ["string", "number"] },
        "scim_id": { "type": ["string", "number"] },
        "givenName": { "type": "string" },
        "given_name": { "type": "string" },
        "familyName": { "type": "string" },
        "family_name": { "type": "string" },
        "displayName": { "type": "string" },
        "display_name": { "type": "string" },
        "githubPermission": { "type": "string" },
        "github_permission": { "type": "string" },
        "permission": { "type": "string" },
        "role": { "type": "string" },
        "roleName": { "type": "string" },
        "role_name": { "type": "string" },
        "workspaceRole": { "type": "string" },
        "workspace_role": { "type": "string" },
        "postmanRole": { "type": "string" },
        "postman_role": { "type": "string" },
        "permissions": {
          "type": "object",
          "additionalProperties": { "type": "boolean" }
        }
      },
      "additionalProperties": true
    }
  }
}
